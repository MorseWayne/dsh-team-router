{
  "name": "dsh-team-router",
  "version": "0.4.0",
  "description": "Seven task-category presets and authorized creation-time model routing for native DeepSeek Harness Agent Teams.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MorseWayne/dsh-team-router.git"
  },
  "homepage": "https://github.com/MorseWayne/dsh-team-router#readme",
  "bugs": {
    "url": "https://github.com/MorseWayne/dsh-team-router/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./policy": { "types": "./lib/core/policy.d.ts", "default": "./lib/core/policy.js" },
    "./routing-policy": { "types": "./lib/core/routing-policy.d.ts", "default": "./lib/core/routing-policy.js" },
    "./categories": { "types": "./lib/core/categories.d.ts", "default": "./lib/core/categories.js" },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "docs", "examples", "locale/*.json", "icon.svg"],
  "icon": "./icon.svg",
  "engines": { "node": ">=24", "dsh": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-remotes"]
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-team": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3 || 0.2.2-rc.4 || 0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cosmokit": "~1.9.0",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.5",
    "@deepseek-ai/dsh-config-editor": "0.2.2-rc.5",
    "react": "^18.3.1",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.12",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent-fork-in-process": "0.2.2-rc.5",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  },
  "license": "MIT"
}
